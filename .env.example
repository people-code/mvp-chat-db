# Used by `npm run dev` (running the app directly on the host, against
# `docker compose up -d db`) and by `npm run db:generate` / `db:migrate`.
#
# `docker compose up` (full stack: app + db) does NOT read this file — its
# equivalent values are set directly in docker-compose.yml (DATABASE_URL uses
# the `db` service hostname, OLLAMA_BASE_URL uses `host.docker.internal`).
# Edit docker-compose.yml directly if you need different values there
# (e.g. Linux: http://172.17.0.1:11434 for OLLAMA_BASE_URL).

DATABASE_URL=postgres://app:app@localhost:5432/app
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
APP_DOMAIN=salud
NUXT_PUBLIC_APP_NAME="Asistente de agendamiento"
